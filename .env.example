# Copy to `.env` at the repo root. Every value is optional.
#
# With the whole file commented out the app signals through the public PeerJS
# cloud broker, which is what the milestones are developed against. It is rate
# limited and periodically unreliable, so when it starts misbehaving run your
# own with `npx peerjs --port 9000 --path /dino` and uncomment the block below.
# Nothing in the code needs to change.

# --- Signalling broker -------------------------------------------------------
# VITE_PEER_HOST=localhost
# VITE_PEER_PORT=9000
# VITE_PEER_PATH=/dino
# VITE_PEER_SECURE=false
# VITE_PEER_KEY=peerjs

# PeerJS log level: 0 silent, 1 errors, 2 warnings, 3 everything.
# VITE_PEER_DEBUG=2

# --- ICE ---------------------------------------------------------------------
# PeerJS ships Google STUN by default, which is enough unless one of you is
# behind symmetric NAT. TURN is the fix, and TURN needs credentials. Set the
# whole ICE list as JSON to override PeerJS's defaults entirely.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# --- Netplay ------------------------------------------------------------------
# Input delay, in emulated frames. Input sampled on frame F is scheduled for
# frame F + delay, so this is how long a peer's packet has to travel before
# everyone stalls waiting for it. One frame is ~16.8ms.
# Leave unset to derive it from measured RTT on every resync.
# VITE_INPUT_DELAY_FRAMES=3

# How long a peer may go silent before the others drop it and carry on, in ms.
# Lower feels more responsive when someone crashes; too low and a brief network
# hiccup ejects a player who was fine.
# VITE_PEER_TIMEOUT_MS=2500

# --- Cross-origin isolation --------------------------------------------------
# Only needed if the emulator core turns out to be a threaded WASM build that
# wants SharedArrayBuffer. Sets COOP/COEP on the dev server.
# VITE_CROSS_ORIGIN_ISOLATION=0

{
  "name": "cadillacs-online",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser-based 3-player online co-op for Cadillacs and Dinosaurs (CPS-1.5) over WebRTC",
  "workspaces": [
    "packages/shared",
    "packages/client"
  ],
  "scripts": {
    "dev": "yarn workspace @dino/client dev",
    "build": "yarn workspace @dino/client build",
    "preview": "yarn workspace @dino/client preview",
    "typecheck": "tsc --noEmit",
    "lint:layering": "node scripts/check-layering.mjs",
    "check": "yarn typecheck && yarn lint:layering",
    "verify:m0": "node tools/verify/verify-m0.mjs",
    "verify:m1": "node tools/verify/verify-m1.mjs",
    "verify:m2": "node tools/verify/verify-m2.mjs",
    "verify:m3": "node tools/verify/verify-m3.mjs",
    "verify:m4": "node tools/verify/verify-m4.mjs",
    "verify:m6": "node tools/verify/verify-m6.mjs",
    "verify:fullscreen": "node tools/verify/verify-fullscreen.mjs",
    "verify": "yarn verify:m0 && yarn verify:m1 && yarn verify:m2 && yarn verify:m3 && yarn verify:m4 && yarn verify:m6 && yarn verify:fullscreen",
    "verify:prod": "node tools/verify/verify-prod.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "packageManager": "yarn@4.18.0"
}
